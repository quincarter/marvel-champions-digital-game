{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],
    // The deploy CLI (src/deploy/cli.ts) runs straight under Node's type stripping, which needs real file extensions.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true
  },
  "include": ["src"]
}
