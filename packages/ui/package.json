{
  "name": "@mc/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Lit web components for the client's panel screens (menus, lists, settings), drawn over the Phaser table. Presentational only: no Phaser, no game state, no rules; the client passes every value in.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./title": "./src/entries/title.ts",
    "./tap": "./src/entries/tap.ts",
    "./glyph": "./src/entries/glyph.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vitest": "^5.1.0"
  }
}
