{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The game window: core APIs, native HTTP to MarvelCDB (card art and deck import; see src/platform/native-http.ts) and to the Mod Store's pack host and its GitHub release fallback (src/packs/pack-fetch.ts), opening this repo's GitHub pages, MarvelCDB and the Gideon's Gaming article credited on the Balanced campaign prompt in the default browser (src/platform/platform.ts openExternal), the window mode and size Settings sets, and the Title screen's Quit to desktop (src/platform/desktop-window.ts).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-decorations",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-center",
    "core:window:allow-unmaximize",
    "core:window:allow-set-focus",
    "core:window:allow-set-simple-fullscreen",
    "core:window:allow-close",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://marvelcdb.com/*" },
        { "url": "https://packs.champions-digital-game.com/*" },
        { "url": "https://github.com/quincarter/marvel-champions-mods/releases/download/*" },
        { "url": "https://objects.githubusercontent.com/*" },
        { "url": "https://release-assets.githubusercontent.com/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/quincarter/marvel-champions-digital-game/*" },
        { "url": "https://marvelcdb.com/*" },
        { "url": "https://marvel-champions-digital-game.netlify.app/*" },
        { "url": "https://gideonsgaming.com/*" }
      ]
    }
  ]
}
