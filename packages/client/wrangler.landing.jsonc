// The landing page (site/landing, `pnpm --filter @mc/client site:build:landing`) as an assets-only Worker on
// Cloudflare's free plan: static assets are served free and don't count toward the 100,000 Worker requests a day, and
// with no script nothing here spends them. CI deploys it on every push to main (netlify-deploy.yml, "Deploy the
// landing page") once the CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID secrets exist.
//
// The custom domains are declared here as well as attached in the dashboard: this file is the source of truth for the
// Worker, so a later deploy can't drop a domain it doesn't list. The API token needs Zone > Workers Routes > Edit (and
// Zone > Zone > Read) on champions-digital-game.com for a deploy that lists them.
{
  "name": "mc-landing",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist-landing",
    "html_handling": "auto-trailing-slash",
    // A stray path is a real 404, served by the build's 404.html, which sends an old /releases/<version> link to its
    // release in the history and anything else to the top of the site (vite.site.config.ts).
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "champions-digital-game.com", "custom_domain": true },
    { "pattern": "www.champions-digital-game.com", "custom_domain": true },
  ],
  // Kept beside the custom domains (with routes it would default to off): an address to check a deploy on.
  "workers_dev": true,
  "preview_urls": false,
}
