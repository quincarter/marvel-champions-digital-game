# Marvel Champions: Digital Edition - Local Environment Configuration
# Copy this file to .env for local builds:
#   cp .env-example .env

# Android Keystore configuration
ANDROID_KEYSTORE_PATH=marvel-champions.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEY_PASSWORD=

# iOS release build (scripts/build-ios.mjs). All optional: the Xcode project already carries the team ID,
# and locally Xcode signs with the Apple ID in Xcode > Settings > Accounts.
# IOS_TEAM_ID=
# IOS_EXPORT_METHOD=app-store-connect # or release-testing, enterprise, debugging
# IOS_SIGNING_STYLE=automatic # or manual
# Manual signing only:
# IOS_SIGNING_CERTIFICATE=
# IOS_PROVISIONING_PROFILE=
# Headless automatic signing (CI): an App Store Connect API key with the Admin role
# IOS_ASC_KEY_PATH=
# IOS_ASC_KEY_ID=
# IOS_ASC_ISSUER_ID=
