# Marvel Champions: Digital Edition - Local Environment Configuration
# Copy this file to .env for local builds:
#   cp .env-example .env

# Android Keystore configuration
ANDROID_KEYSTORE_PATH=marvel-champions.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEY_PASSWORD=

# iOS Build configuration (optional overrides)
# IOS_TEAM_ID=
# IOS_EXPORT_METHOD=app-store-connect # or release-testing, enterprise, debugging, developer-id
# IOS_SIGNING_STYLE=automatic # or manual
# IOS_SIGNING_CERTIFICATE=
# IOS_PROVISIONING_PROFILE=
